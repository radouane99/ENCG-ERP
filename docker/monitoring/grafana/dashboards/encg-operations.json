      "id": 1,
      "title": "ERP prêt",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "encg-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "probe_success{job=\"encg-readiness\"}",
          "refId": "A",
          "legendFormat": "Valeur"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Indisponible",
                  "color": "red"
                },
                "1": {
                  "text": "Disponible",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "colorMode": "background"
      }
