FROM php:8.4.27-fpm-alpine@sha256:15462d03828e68ae806c552403360edc5269a830d358646a9564dbebe632b787

# Production image: no Xdebug, Composer --no-dev.

RUN apk add --no-cache \
    bash \
    curl \
    git \
    zip \
    unzip \
    libzip-dev \
    libpng-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    icu-dev \
    oniguruma-dev \
    libxml2-dev \
    postgresql-dev \
    postgresql-client \
    fcgi \
    linux-headers \
    $PHPIZE_DEPS \
    tesseract-ocr \
    tesseract-ocr-data-fra \
    tesseract-ocr-data-ara \
    tesseract-ocr-data-eng \
    poppler-utils \
    ghostscript \
    imagemagick \
    imagemagick-pdf \
    imagemagick-dev

RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        pdo \
        pdo_pgsql \
        pgsql \
        mbstring \
        exif \
        pcntl \
        bcmath \
        gd \
        zip \
        intl \
        xml \
        opcache \
        sockets

RUN pecl install redis \
    && docker-php-ext-enable redis \
    && apk del $PHPIZE_DEPS

COPY --from=composer:2@sha256:8de2184c6de224f4689e8f80ed5f5edaf0030b6b8b7839a22a2bcb6722ac87d0 /usr/bin/composer /usr/bin/composer

RUN addgroup -g 1000 -S www \
    && adduser -u 1000 -S www -G www

WORKDIR /var/www/html

COPY --chown=www:www backend/composer.json backend/composer.lock /var/www/html/

RUN mkdir -p /var/www/html/storage/logs \
             /var/www/html/storage/framework/cache \
             /var/www/html/storage/framework/sessions \
             /var/www/html/storage/framework/views \
             /var/www/html/bootstrap/cache \
             /var/www/html/vendor \
    && chown -R www:www /var/www/html

USER www
RUN composer install --no-dev --no-interaction --prefer-dist --no-scripts --no-autoloader
COPY --chown=www:www backend/ /var/www/html/
RUN mkdir -p storage/logs storage/framework/cache/data storage/framework/sessions storage/framework/views bootstrap/cache \
    && composer dump-autoload --no-dev --no-interaction --optimize --classmap-authoritative --no-scripts \
    && php artisan package:discover --ansi

COPY docker/php/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
COPY docker/php/healthcheck.sh /usr/local/bin/healthcheck.sh
USER root
RUN chmod +x /usr/local/bin/docker-entrypoint.sh /usr/local/bin/healthcheck.sh
USER www

EXPOSE 9000
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["php-fpm"]
