APP_NAME="ENCG ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://erp.encg-fes.ac.ma
FRONTEND_URL=https://erp.encg-fes.ac.ma

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ── PostgreSQL 16 ─────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=encg_erp
DB_USERNAME=encg_prod_user
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD

# ── Redis 7 ───────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=YOUR_STRONG_REDIS_PASSWORD
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ── Resend Email Provider (ENCG Portal) ───────────────────
MAIL_MAILER=resend
RESEND_API_KEY=re_your_production_resend_api_key
MAIL_FROM_ADDRESS="noreply@encg-fes.ac.ma"
MAIL_FROM_NAME="ENCG Portail"

# ── S3 / MinIO Object Storage ─────────────────────────────
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=YOUR_MINIO_OR_S3_KEY
AWS_SECRET_ACCESS_KEY=YOUR_MINIO_OR_S3_SECRET
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=encg-documents
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=https://erp.encg-fes.ac.ma/s3

# ── AI & Smart Campus ─────────────────────────────────────
AI_DRIVER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash

# ── Security & Authentication ─────────────────────────────
SANCTUM_STATEFUL_DOMAINS=erp.encg-fes.ac.ma
SESSION_DOMAIN=.encg-fes.ac.ma
SESSION_SECURE_COOKIE=true
TRUSTED_PROXIES=*

# SMS campus (log = notification_logs only, no operator)
SMS_DRIVER=log

# ── Sentry ────────────────────────────────────────────────
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production

# ── Koha ILS ──────────────────────────────────────────────
KOHA_BASE_URL=
KOHA_API_KEY=
