APP_NAME="ENCG ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://erp.encg-fes.ac.ma
FRONTEND_URL=https://erp.encg-fes.ac.ma

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ── PostgreSQL 16 ─────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=encg_erp
DB_USERNAME=encg_prod_user
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD
DB_SSLMODE=require

# ── Redis 7 ───────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=YOUR_STRONG_REDIS_PASSWORD
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ── Resend Email Provider (ENCG Portal) ───────────────────
MAIL_MAILER=resend
RESEND_API_KEY=re_your_production_resend_api_key
MAIL_FROM_ADDRESS="noreply@encg-fes.ac.ma"
MAIL_FROM_NAME="ENCG Portail"

# ── Filesystem — Laravel local disks (storage/) ───────────
FILESYSTEM_DISK=local

# ── AI & Smart Campus ─────────────────────────────────────
AI_DRIVER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash

# ── Security & Authentication ─────────────────────────────
SANCTUM_STATEFUL_DOMAINS=erp.encg-fes.ac.ma
SESSION_DOMAIN=.encg-fes.ac.ma
SESSION_SECURE_COOKIE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
TRUSTED_PROXIES=*
TELESCOPE_ENABLED=false
CORS_ALLOWED_ORIGINS=https://erp.encg-fes.ac.ma
BCRYPT_ROUNDS=12

# ── SSO OpenID Connect ─────────────────────────────────────
SSO_ALLOWED_DOMAINS=encg-fes.ac.ma,usmba.ac.ma,gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://erp.encg-fes.ac.ma/api/v1/auth/sso/google/callback
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=organizations
AZURE_AD_REDIRECT_URI=https://erp.encg-fes.ac.ma/api/v1/auth/sso/microsoft/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://erp.encg-fes.ac.ma/api/v1/auth/sso/oidc/callback

# SMS campus (log = notification_logs only, no operator)
SMS_DRIVER=log

# ── Sentry ────────────────────────────────────────────────
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production

# ── Koha ILS ──────────────────────────────────────────────
KOHA_BASE_URL=
KOHA_API_KEY=

# ── Cloudflare Tunnel (docker-compose cloudflared) ────────
CLOUDFLARE_TUNNEL_TOKEN=
